{
  "name": "llm-primer",
  "description": "A bilingual, multi-tier, community-driven knowledge base for LLM principles, papers, and interactive demos.",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "author": "Albert Lv <albert.lv@example.com>",
  "license": "MIT",
  "homepage": "https://llm-primer.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/albert-lv/LLM-primer.git"
  },
  "bugs": {
    "url": "https://github.com/albert-lv/LLM-primer/issues"
  },
  "keywords": [
    "llm",
    "large-language-models",
    "transformer",
    "attention",
    "rag",
    "retrieval-augmented-generation",
    "ai",
    "machine-learning",
    "nlp",
    "papers",
    "knowledge-base",
    "bilingual",
    "education",
    "open-source"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
