    "lint:content": "node scripts/check-content.mjs",
    "new:article": "node scripts/new-article.mjs"
  },
  "dependencies": {
    "@astrojs/react": "4.3.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "3.1.6",
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.15.8",
    "js-tiktoken": "1.0.21",
    "katex": "0.16.47",
    "mermaid": "^11.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "^25.9.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "happy-dom": "^20.9.0",
    "pagefind": "1.5.2",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  }
